{
 "hash": "283428b62d65dca5",
 "voz": "kokoro-em_alex",
 "duracion": 37.234,
 "segmentos": [
  {
   "tipo": "gancho",
   "i": 0,
   "voz_desde": 0.0,
   "voz_hasta": 3.144,
   "desde": 0.0,
   "hasta": 3.394,
   "coincidencia": 1.0,
   "transcripcion": "Correr te quita fuerza. Vamos a los datos."
  },
  {
   "tipo": "texto",
   "i": 1,
   "voz_desde": 3.394,
   "voz_hasta": 6.879,
   "desde": 3.394,
   "hasta": 7.129,
   "coincidencia": 1.0,
   "transcripcion": "Fuerza y carrera en el mismo plan se pisan las ganancias."
  },
  {
   "tipo": "grafica",
   "i": 2,
   "voz_desde": 7.129,
   "voz_hasta": 14.412,
   "desde": 7.129,
   "hasta": 14.662,
   "coincidencia": 1.0,
   "transcripcion": "Un metaanálisis de cuarenta y tres estudios no encontró diferencias claras ni en fuerza máxima ni en masa muscular."
  },
  {
   "tipo": "texto",
   "i": 3,
   "voz_desde": 14.662,
   "voz_hasta": 20.425,
   "desde": 14.662,
   "hasta": 20.675,
   "coincidencia": 1.0,
   "transcripcion": "La fuerza explosiva si mejoró algo menos, sobre todo al hacer las dos cosas en la misma sesión."
  },
  {
   "tipo": "texto",
   "i": 4,
   "voz_desde": 20.675,
   "voz_hasta": 24.181,
   "desde": 20.675,
   "hasta": 24.431,
   "coincidencia": 1.0,
   "transcripcion": "Así que, si puedes, haz cada cosa en una sesión distinta."
  },
  {
   "tipo": "conclusion",
   "voz_desde": 24.431,
   "voz_hasta": 26.242,
   "desde": 24.431,
   "hasta": 26.631,
   "coincidencia": 1.0,
   "transcripcion": "Fuerza y carrera sí suman."
  },
  {
   "tipo": "aplicacion",
   "voz_desde": 26.631,
   "voz_hasta": 32.82,
   "desde": 26.631,
   "hasta": 33.07,
   "coincidencia": 1.0,
   "transcripcion": "Sepáralas cuando puedas. Haz primero lo que más te importe ese día y no recortes kilómetros por miedo."
  },
  {
   "tipo": "cierre",
   "voz_desde": 33.07,
   "voz_hasta": 35.734,
   "desde": 33.07,
   "hasta": 37.234,
   "coincidencia": 1.0,
   "transcripcion": "Guárdalo y pruébalo en tu próximo entreno."
  }
 ],
