   "desde": 0.0,
   "hasta": 2.92,
   "transcripcion": "Correr te quita fuerza. Vamos a los datos."
  },
  {
   "tipo": "texto",
   "i": 1,
   "voz_desde": 2.92,
   "voz_hasta": 6.379,
   "desde": 2.92,
   "hasta": 6.629,
   "transcripcion": "Fuerza y carrera en el mismo plan, ¿se pisan las ganancias?"
  },
  {
   "tipo": "grafica",
   "i": 2,
   "voz_desde": 6.629,
   "voz_hasta": 13.491,
   "desde": 6.629,
   "hasta": 13.741,
   "transcripcion": "Un metaanálisis de cuarenta y tres estudios no encontró diferencias claras ni en fuerza máxima ni en masa muscular."
  },
  {
   "tipo": "texto",
   "i": 3,
   "voz_desde": 13.741,
   "voz_hasta": 19.43,
   "desde": 13.741,
   "hasta": 19.68,
   "transcripcion": "La fuerza explosiva sí mejoró algo menos, sobre todo al hacer las dos cosas en la misma sesión."
  },
  {
   "tipo": "texto",
   "i": 4,
   "voz_desde": 19.68,
   "voz_hasta": 22.815,
   "desde": 19.68,
   "hasta": 23.065,
   "transcripcion": "¡Suscríbete!"
  },
  {
   "tipo": "conclusion",
   "voz_desde": 23.065,
   "voz_hasta": 24.806,
   "desde": 23.065,
   "hasta": 25.265,
   "transcripcion": "Fuerza y carrera sí suman."
  },
  {
   "tipo": "aplicacion",
   "voz_desde": 25.265,
   "voz_hasta": 31.035,
   "desde": 25.265,
   "hasta": 31.285,
   "transcripcion": "Sepáralas cuando puedas, haz primero lo que más te importe ese día y no recortes kilómetros por miedo."
  },
  {
   "tipo": "cierre",
   "voz_desde": 31.285,
   "voz_hasta": 33.7,
   "desde": 31.285,
   "hasta": 35.2,
   "transcripcion": "Guárdalo y pruébalo en tu próximo entreno."
  }
