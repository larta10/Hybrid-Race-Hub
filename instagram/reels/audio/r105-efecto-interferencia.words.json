 "duracion": 37.334,
 "segmentos": [
  {
   "tipo": "gancho",
   "i": 0,
   "desde": 0.0,
   "voz_desde": 0.0,
   "voz_hasta": 3.244,
   "hasta": 3.494,
   "transcripcion": "Correr te quita fuerza. Vamos a los datos."
  },
  {
   "tipo": "texto",
   "i": 1,
   "desde": 3.494,
   "voz_desde": 3.494,
   "voz_hasta": 6.979,
   "hasta": 7.229,
   "transcripcion": "Fuerza y carrera en el mismo plan se pisan las ganancias."
  },
  {
   "tipo": "grafica",
   "i": 2,
   "desde": 7.229,
   "voz_desde": 7.229,
   "voz_hasta": 14.512,
   "hasta": 14.762,
   "transcripcion": "Un metaanálisis de cuarenta y tres estudios no encontró diferencias claras ni en fuerza máxima ni en masa muscular."
  },
  {
   "tipo": "texto",
   "i": 3,
   "desde": 14.762,
   "voz_desde": 14.762,
   "voz_hasta": 20.525,
   "hasta": 20.775,
   "transcripcion": "La fuerza explosiva sí mejoró algo menos, sobre todo al hacer las dos cosas en la misma sesión."
  },
  {
   "tipo": "texto",
   "i": 4,
   "desde": 20.775,
   "voz_desde": 20.775,
   "voz_hasta": 24.281,
   "hasta": 24.531,
   "transcripcion": "Así que si puedes, haz cada cosa en una sesión distinta."
  },
  {
   "tipo": "conclusion",
   "desde": 24.531,
   "voz_desde": 24.531,
   "voz_hasta": 26.342,
   "hasta": 26.731,
   "transcripcion": "fuerza y carrera si suman"
  },
  {
   "tipo": "aplicacion",
   "desde": 26.731,
   "voz_desde": 26.731,
   "voz_hasta": 32.92,
   "hasta": 33.17,
   "transcripcion": "Sepáralas cuando puedas, haz primero lo que más te importe ese día y no recortes kilómetros por miedo."
  },
  {
   "tipo": "cierre",
   "desde": 33.17,
   "voz_desde": 33.17,
   "voz_hasta": 35.834,
   "hasta": 37.334,
   "transcripcion": "Guárdalo y pruébalo en tu próximo entreno."
  }
 ],
 "frases": [
  {
   "seg": 0,
   "desde": 0.0,
   "hasta": 1.619,
   "texto": "¿Correr te quita fuerza?"
  },
  {
   "seg": 0,
   "desde": 1.939,
   "hasta": 3.244,
   "texto": "Vamos a los datos."
  },
  {
   "seg": 1,
   "desde": 3.494,
   "hasta": 6.979,
   "texto": "Fuerza y carrera en el mismo plan: ¿se pisan las ganancias?"
  },
  {
   "seg": 2,
   "desde": 7.229,
   "hasta": 14.512,
   "texto": "Un metaanálisis de cuarenta y tres estudios no encontró diferencias claras ni en fuerza máxima ni en masa muscular."
  },
  {
   "seg": 3,
   "desde": 14.762,
   "hasta": 20.525,
   "texto": "La fuerza explosiva sí mejoró algo menos, sobre todo al hacer las dos cosas en la misma sesión."
  },
  {
   "seg": 4,
   "desde": 20.775,
   "hasta": 24.281,
   "texto": "Así que, si puedes, haz cada cosa en una sesión distinta."
  },
  {
   "seg": 5,
   "desde": 24.531,
   "hasta": 26.342,
   "texto": "Fuerza y carrera sí suman."
  },
  {
   "seg": 6,
   "desde": 26.731,
   "hasta": 32.92,
   "texto": "Sepáralas cuando puedas, haz primero lo que más te importe ese día y no recortes kilómetros por miedo."
  },
  {
   "seg": 7,
   "desde": 33.17,
   "hasta": 35.834,
   "texto": "Guárdalo y pruébalo en tu próximo entreno."
  }
 ],
