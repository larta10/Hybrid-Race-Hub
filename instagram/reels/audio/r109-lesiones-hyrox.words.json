{
 "hash": "ee2acc490dbfae60",
 "voz": "kokoro-em_alex",
 "duracion": 37.102,
 "segmentos": [
  {
   "tipo": "gancho",
   "i": 0,
   "voz_desde": 0.0,
   "voz_hasta": 2.72,
   "desde": 0.0,
   "hasta": 2.97,
   "coincidencia": 1.0,
   "transcripcion": "Te duele algo, no eres el único."
  },
  {
   "tipo": "texto",
   "i": 1,
   "voz_desde": 2.97,
   "voz_hasta": 7.703,
   "desde": 2.97,
   "hasta": 7.953,
   "coincidencia": 1.0,
   "transcripcion": "Un estudio siguió a ochenta y nueve atletas de HYROX durante doce semanas."
  },
  {
   "tipo": "grafica",
   "i": 2,
   "voz_desde": 7.953,
   "voz_hasta": 12.46,
   "desde": 7.953,
   "hasta": 12.71,
   "coincidencia": 1.0,
   "transcripcion": "De media cada semana, tres de cada diez tenían algún problema de salud."
  },
  {
   "tipo": "grafica",
   "i": 3,
   "voz_desde": 12.71,
   "voz_hasta": 18.617,
   "desde": 12.71,
   "hasta": 18.867,
   "coincidencia": 1.0,
   "transcripcion": "Y el setenta y tres por ciento de las lesiones fueron por sobrecarga, se acumularon con el entreno."
  },
  {
   "tipo": "texto",
   "i": 4,
   "voz_desde": 18.867,
   "voz_hasta": 23.926,
   "desde": 18.867,
   "hasta": 24.176,
   "coincidencia": 1.0,
   "transcripcion": "La zona más afectada fue la rodilla, con el veintidós por ciento de los episodios."
  },
  {
   "tipo": "conclusion",
   "voz_desde": 24.176,
   "voz_hasta": 25.792,
   "desde": 24.176,
   "hasta": 26.376,
   "coincidencia": 1.0,
   "transcripcion": "Lo que duele se acumula."
  },
  {
   "tipo": "aplicacion",
   "voz_desde": 26.376,
   "voz_hasta": 33.138,
   "desde": 26.376,
   "hasta": 33.388,
   "coincidencia": 1.0,
   "transcripcion": "Sube la carrera poco a poco, apunta cada semana lo que te molesta y, si arrastras una lesión, que la vea un fisio."
  },
  {
   "tipo": "cierre",
   "voz_desde": 33.388,
   "voz_hasta": 35.602,
   "desde": 33.388,
   "hasta": 37.102,
   "coincidencia": 1.0,
   "transcripcion": "Guárdalo y compártelo con tu grupo."
  }
 ],
