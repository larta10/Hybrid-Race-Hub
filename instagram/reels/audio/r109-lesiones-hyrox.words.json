 "duracion": 37.202,
 "segmentos": [
  {
   "tipo": "gancho",
   "i": 0,
   "desde": 0.0,
   "voz_desde": 0.0,
   "voz_hasta": 2.82,
   "hasta": 3.07,
   "transcripcion": "¿Te duele algo? No eres el único."
  },
  {
   "tipo": "texto",
   "i": 1,
   "desde": 3.07,
   "voz_desde": 3.07,
   "voz_hasta": 7.803,
   "hasta": 8.053,
   "transcripcion": "Un estudio siguió a ochenta y nueve atletas de HYROX durante doce semanas."
  },
  {
   "tipo": "grafica",
   "i": 2,
   "desde": 8.053,
   "voz_desde": 8.053,
   "voz_hasta": 12.56,
   "hasta": 12.81,
   "transcripcion": "De media cada semana, tres de cada diez tenían algún problema de salud."
  },
  {
   "tipo": "grafica",
   "i": 3,
   "desde": 12.81,
   "voz_desde": 12.81,
   "voz_hasta": 18.717,
   "hasta": 18.967,
   "transcripcion": "Y el setenta y tres por ciento de las lesiones fueron por sobrecarga se acumularon con el entreno."
  },
  {
   "tipo": "texto",
   "i": 4,
   "desde": 18.967,
   "voz_desde": 18.967,
   "voz_hasta": 24.026,
   "hasta": 24.276,
   "transcripcion": "La zona más afectada fue la rodilla, con el veintidós por ciento de los episodios."
  },
  {
   "tipo": "conclusion",
   "desde": 24.276,
   "voz_desde": 24.276,
   "voz_hasta": 25.892,
   "hasta": 26.476,
   "transcripcion": "Lo que duele se acumula."
  },
  {
   "tipo": "aplicacion",
   "desde": 26.476,
   "voz_desde": 26.476,
   "voz_hasta": 33.238,
   "hasta": 33.488,
   "transcripcion": "Sube la carrera poco a poco, apunta cada semana lo que te molesta y si arrastras una lesión que la vea un fisio."
  },
  {
   "tipo": "cierre",
   "desde": 33.488,
   "voz_desde": 33.488,
   "voz_hasta": 35.702,
   "hasta": 37.202,
   "transcripcion": "Guárdalo y compártelo con tu grupo."
  }
 ],
 "frases": [
  {
   "seg": 0,
   "desde": 0.0,
   "hasta": 1.149,
   "texto": "¿Te duele algo?"
  },
  {
   "seg": 0,
   "desde": 1.469,
   "hasta": 2.82,
   "texto": "No eres el único."
  },
  {
   "seg": 1,
   "desde": 3.07,
   "hasta": 7.803,
   "texto": "Un estudio siguió a ochenta y nueve atletas de HYROX durante doce semanas."
  },
  {
   "seg": 2,
   "desde": 8.053,
   "hasta": 12.56,
   "texto": "De media, cada semana, tres de cada diez tenían algún problema de salud."
  },
  {
   "seg": 3,
   "desde": 12.81,
   "hasta": 18.717,
   "texto": "Y el setenta y tres por ciento de las lesiones fueron por sobrecarga: se acumularon con el entreno."
  },
  {
   "seg": 4,
   "desde": 18.967,
   "hasta": 24.026,
   "texto": "La zona más afectada fue la rodilla, con el veintidós por ciento de los episodios."
  },
  {
   "seg": 5,
   "desde": 24.276,
   "hasta": 25.892,
   "texto": "Lo que duele, se acumula."
  },
  {
   "seg": 6,
   "desde": 26.476,
   "hasta": 33.238,
   "texto": "Sube la carrera poco a poco, apunta cada semana lo que te molesta y, si arrastras una lesión, que la vea un fisio."
  },
  {
   "seg": 7,
   "desde": 33.488,
   "hasta": 35.702,
   "texto": "Guárdalo y compártelo con tu grupo."
  }
 ],
