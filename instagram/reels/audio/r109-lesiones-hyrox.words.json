 "duracion": 35.095,
 "segmentos": [
  {
   "tipo": "gancho",
   "i": 0,
   "voz_desde": 0.0,
   "voz_hasta": 2.298,
   "desde": 0.0,
   "hasta": 2.548,
   "transcripcion": "¿Te duele algo? No eres el único."
  },
  {
   "tipo": "texto",
   "i": 1,
   "voz_desde": 2.548,
   "voz_hasta": 7.03,
   "desde": 2.548,
   "hasta": 7.28,
   "transcripcion": "Un estudio siguió a ochenta y nueve atletas de HYROX durante doce semanas."
  },
  {
   "tipo": "grafica",
   "i": 2,
   "voz_desde": 7.28,
   "voz_hasta": 11.088,
   "desde": 7.28,
   "hasta": 11.338,
   "transcripcion": "De media, cada semana, tres de cada diez tenían algún problema de salud."
  },
  {
   "tipo": "grafica",
   "i": 3,
   "voz_desde": 11.338,
   "voz_hasta": 17.352,
   "desde": 11.338,
   "hasta": 17.602,
   "transcripcion": "Y el setenta y tres por ciento de las lesiones fueron por sobrecarga se acumularon con el entreno."
  },
  {
   "tipo": "texto",
   "i": 4,
   "voz_desde": 17.602,
   "voz_hasta": 22.013,
   "desde": 17.602,
   "hasta": 22.263,
   "transcripcion": "La zona más afectada fue la rodilla, con el veintidós por ciento de los episodios."
  },
  {
   "tipo": "conclusion",
   "voz_desde": 22.263,
   "voz_hasta": 23.61,
   "desde": 22.263,
   "hasta": 24.463,
   "transcripcion": "Lo que duele, se acumula."
  },
  {
   "tipo": "aplicacion",
   "voz_desde": 24.463,
   "voz_hasta": 31.279,
   "desde": 24.463,
   "hasta": 31.529,
   "transcripcion": "Sube la carrera poco a poco, apunta cada semana lo que te molesta y, si arrastras una lesión, que la vea un fisio."
  },
  {
   "tipo": "cierre",
   "voz_desde": 31.529,
   "voz_hasta": 33.595,
   "desde": 31.529,
   "hasta": 35.095,
   "transcripcion": "Guárdalo y compártelo con tu grupo."
  }
 ],
