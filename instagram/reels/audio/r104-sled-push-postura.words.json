{
 "hash": "92dd3bc2b5f7d7d3",
 "voz": "kokoro-em_alex",
 "duracion": 39.425,
 "segmentos": [
  {
   "tipo": "gancho",
   "i": 0,
   "voz_desde": 0.0,
   "voz_hasta": 2.334,
   "desde": 0.0,
   "hasta": 2.584,
   "coincidencia": 1.0,
   "transcripcion": "El trineo no se empuja con la espalda."
  },
  {
   "tipo": "texto",
   "i": 1,
   "voz_desde": 2.584,
   "voz_hasta": 7.327,
   "desde": 2.584,
   "hasta": 7.577,
   "coincidencia": 1.0,
   "transcripcion": "Tronco inclinado, espalda neutra, brazos largos y pasos cortos y rápidos."
  },
  {
   "tipo": "texto",
   "i": 2,
   "voz_desde": 7.577,
   "voz_hasta": 12.473,
   "desde": 7.577,
   "hasta": 12.723,
   "coincidencia": 1.0,
   "transcripcion": "El error típico, cadera alta y espalda redonda. Así la fuerza se pierde."
  },
  {
   "tipo": "texto",
   "i": 3,
   "voz_desde": 12.723,
   "voz_hasta": 17.849,
   "desde": 12.723,
   "hasta": 18.099,
   "coincidencia": 1.0,
   "transcripcion": "Empujan los glúteos, los cuadriceps y los gemelos. Los brazos sólo transmiten."
  },
  {
   "tipo": "grafica",
   "i": 4,
   "voz_desde": 18.099,
   "voz_hasta": 27.36,
   "desde": 18.099,
   "hasta": 27.61,
   "coincidencia": 1.0,
   "transcripcion": "En una simulación con atletas populares, empujar el trineo llevó una mediana de ciento veintiocho segundos. Arrastrarlo ciento cincuenta y cinco"
  },
  {
   "tipo": "conclusion",
   "voz_desde": 27.61,
   "voz_hasta": 30.022,
   "desde": 27.61,
   "hasta": 30.272,
   "coincidencia": 1.0,
   "transcripcion": "Primero el ángulo, después la fuerza."
  },
  {
   "tipo": "aplicacion",
   "voz_desde": 30.272,
   "voz_hasta": 35.011,
   "desde": 30.272,
   "hasta": 35.261,
   "coincidencia": 1.0,
   "transcripcion": "Grábate de lado, no pares el trineo y mete empujes cortos después de correr."
  },
  {
   "tipo": "cierre",
   "voz_desde": 35.261,
   "voz_hasta": 37.925,
   "desde": 35.261,
   "hasta": 39.425,
   "coincidencia": 1.0,
   "transcripcion": "Guárdalo y pruébalo en tu próximo entreno."
  }
 ],
